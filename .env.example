ILOM_HOST=192.168.1.101
ILOM_USER=root
ILOM_PASSWORD=replace-with-password
# Optional: VNC password for ilom-vnc (required to listen beyond loopback)
# ILOM_VNC_PASSWORD=
# Several ILOMs (hosts.toml): per-host passwords, NAME in capitals
# ILOM_PASSWORD_RACK1=
# ILOM_VNC_PASSWORD_RACK1=
# With hosts.toml, passwords can also be saved in the OS keyring from the viewer
# (used when no ILOM_PASSWORD* variable is set)
# ilom-mcp read_screen (build with --features ocr): directory holding
# text-detection.onnx and text-recognition.onnx (default: ocr-models/ in the config directory)
# ILOM_OCR_MODELS=
